    enabled: true
    url: https://remoteok.com/api
  weworkremotely:
    enabled: true
    url: https://weworkremotely.com/categories/remote-programming-jobs.rss
  hackernews:
    enabled: true
    base_url: https://news.ycombinator.com
  greenhouse:
