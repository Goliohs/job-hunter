profile:
  name: Tu Nombre
  first_name: Tu
  last_name: Nombre
  email: tu@email.com
  phone: +00 00000000
  linkedin: https://linkedin.com/in/tuusuario
  github: https://github.com/tuusuario
  portfolio: https://tuportfolio.com
  cover_letter: 'Breve resumen profesional: años de experiencia, stack principal,
    diferenciadores.'
  visa_status: No visa required for remote work
  notice_period: Immediate
  salary_expectation: Negotiable
  target_roles:
  - DevOps Engineer
  - Platform Engineer
  - SRE
  max_years_experience: 15
  skills:
  - Docker
  - Kubernetes
  - Linux
  - Python
  remote_only: true
  worldwide: true
  dealbreakers:
  - onsite
  - hybrid
  - relocation required
  - junior
  preferences:
  - remote
  - worldwide
  - async
  location: Your City, Country
  years_experience: 5
  how_heard_answer: Job posting online
  question_answers:
    keyword in question: Exact answer text
  english_level: Advanced
sources:
  remotive:
    enabled: true
    url: https://remotive.com/api/remote-jobs
    categories:
    - software-dev
    - web-development
    - backend
    - frontend
    - fullstack
    - devops
    - sysadmin
    - data
