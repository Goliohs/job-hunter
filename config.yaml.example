  linkedin:
    enabled: true
    searches:
      devops_remote: https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?keywords=devops%20OR%20site%20reliability%20OR%20platform%20engineer&location=Remote&trk=public_jobs_jobs-search-bar_search-submit&position=1&pageNum=0
      fullstack_remote: https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?keywords=full%20stack%20OR%20backend%20OR%20python%20OR%20golang&location=Remote&trk=public_jobs_jobs-search-bar_search-submit&position=1&pageNum=0
      ai_ml_remote: https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?keywords=ai%20OR%20machine%20learning%20OR%20llm%20OR%20mlops&location=Remote&trk=public_jobs_jobs-search-bar_search-submit&position=1&pageNum=0
      frontend_remote: https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?keywords=react%20OR%20frontend%20OR%20typescript&location=Remote&trk=public_jobs_jobs-search-bar_search-submit&position=1&pageNum=0
  linkedin_easy_apply:
    enabled: true
    keywords:
    - devops
    - site reliability
    - platform engineer
    - kubernetes
    - python
    - golang
    - devops engineer
    - sre
    - devsecops
    location: Remote
    max_pages: 3
  standard_ats:
    enabled: true
    keywords:
    - devops
    - kubernetes
    - python
    - golang
    - sre
    - devops engineer
    - platform engineer
    - devsecops
    location: Remote
  wellfound:
    enabled: false
    search_urls:
    - https://wellfound.com/jobs?locations[]=Remote&roles[]=Software%20Engineer&roles[]=DevOps%20Engineer&roles[]=Data%20Engineer&roles[]=Backend%20Engineer&roles[]=Fullstack%20Engineer&roles[]=Platform%20Engineer&roles[]=SRE
    - https://wellfound.com/jobs?locations[]=Remote&roles[]=Engineering%20Manager&roles[]=CTO&roles[]=VP%20Engineering&roles[]=Staff%20Engineer&roles[]=Principal%20Engineer
    - https://wellfound.com/jobs?locations[]=Remote&roles[]=AI%20Engineer&roles[]=ML%20Engineer&roles[]=Data%20Scientist
    max_pages: 3
  yc_jobs:
    enabled: false
    max_pages: 5
  wellfound_pw:
    enabled: true
    max_pages: 3
  yc_jobs_pw:
    enabled: true
    max_pages: 3
  ats_career_pages:
    enabled: true
    greenhouse: *id001
    lever: *id002
    ashby: *id003
llm:
  api_url: https://integrate.api.nvidia.com/v1/chat/completions
  api_key_env: NIM_API_KEY
  model: deepseek-ai/deepseek-v4-flash-0731
  temperature: 0.3
  max_tokens: 500
filter:
  min_score: 60
  high_match_threshold: 70
  max_jobs_per_run: 5
database:
  path: jobs.db
alerts:
  telegram:
    enabled: false
    bot_token_env: TELEGRAM_BOT_TOKEN
    chat_id_env: TELEGRAM_CHAT_ID
  email:
    enabled: false
    smtp_host: smtp.gmail.com
    smtp_port: 587
    username_env: SMTP_USER
    password_env: SMTP_PASS
    from_email_env: ALERT_FROM_EMAIL
    to_emails_env: ALERT_TO_EMAILS
auto_apply:
  enabled: false
  max_per_day: 5
  ats_platforms:
  - lever
  - greenhouse
  - ashby
generator:
  cover_letter_template: 'Estimado equipo de {company},


    Me dirijo a ustedes como {candidate_summary}. Me emociona la oportunidad de unirme
    a su equipo como {job_title}.


    Destacaría mi experiencia en {top_skills}, que se alinea perfectamente con los
    requisitos de la oferta. Además, mi experiencia con infraestructura propia (homelab,
    GPU nodes, bare metal) y Private AI (Ollama, local LLMs) me permite ofrecer una
    perspectiva única.


    Me gustaría solicitar una entrevista técnica para discutir cómo puedo aportar
    valor.


    Atentamente,

    {candidate_name}

    '
  cv_template: '{candidate_name}

    Email: {email} | Phone: {phone}

    LinkedIn: {linkedin} | GitHub: {github}

    Portfolio: {portfolio}


    EXPERIENCE:

    {experience}


    SKILLS:

    {skills}


    EDUCATION:

    {education}'
