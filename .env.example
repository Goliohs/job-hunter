# Job Hunter Bot - Environment Variables
# Copy this to .env and fill in your credentials

# NVIDIA NIM API (already configured)
NIM_API_KEY=nvapi-YOUR_NIM_API_KEY

# --- Email Alerts (Gmail example) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password  # Use App Password, not regular password
# ALERT_FROM_EMAIL=your_email@gmail.com
# ALERT_TO_EMAILS=your_email@gmail.com,other@email.com

# --- Telegram Alerts ---
# TELEGRAM_BOT_TOKEN=123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
# TELEGRAM_CHAT_ID=123456789

# --- Auto-apply credentials (Phase 3) ---
# LINKEDIN_EMAIL=your_email@domain.com
# LINKEDIN_PASSWORD=your_password
# LINKEDIN_2FA_SECRET=optional_2fa_secret

# --- Quick Apply / Dashboard ---
# CV_PATH=/path/to/job-hunter/cv.pdf
# QUICK_APPLY_HEADLESS=false